/* ========================================
   CircuitVault
   Main Application Stylesheet
   ======================================== */


/* ---------- Global ---------- */

QMainWindow {
    background-color: #111827;
}

QWidget {
    color: #e5e7eb;
    font-family: "Segoe UI";
    font-size: 14px;
}


/* ---------- Sidebar ---------- */

QWidget#sidebar {
    background-color: #0f172a;
}

QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;

    padding: 10px 14px;

    text-align: left;

    color: #cbd5e1;
}

QPushButton:hover {
    background-color: #1e293b;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #334155;
}


/* ---------- Page Titles ---------- */

QLabel#pageTitle {
    font-size: 26px;
    font-weight: 600;
    color: #ffffff;
}


/* ---------- Metric Cards ---------- */

QFrame#metricCard {
    background-color: #1e293b;

    border: 1px solid #334155;
    border-radius: 10px;
}

QFrame#metricCard:hover {
    border: 1px solid #64748b;
}

QLabel#metricTitle {
    color: #94a3b8;

    font-size: 13px;
    font-weight: 500;
}

QLabel#metricValue {
    color: #ffffff;

    font-size: 32px;
    font-weight: 700;
}