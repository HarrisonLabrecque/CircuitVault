/* ============================================================
   CIRCUITVAULT - MAIN STYLESHEET
   Version: 0.1.0
   ============================================================ */


/* ============================================================
   GLOBAL
   ============================================================ */

QMainWindow {
    background-color: #111827;
}

QWidget {
    color: #e5e7eb;
    font-family: "Segoe UI";
    font-size: 14px;
}

QWidget#sidebar {
    background-color: #0f172a;
}


/* ============================================================
   SIDEBAR
   ============================================================ */

QLabel#appTitle {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    padding: 15px;
}

QPushButton {
    background-color: transparent;
    color: #cbd5e1;

    border: none;
    border-radius: 6px;

    padding: 10px 14px;
    text-align: left;
}

QPushButton:hover {
    background-color: #1e293b;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #334155;
}

QWidget#sidebar QPushButton[active="true"] {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}


/* ============================================================
   PAGE TITLES
   ============================================================ */

QLabel#pageTitle {
    font-size: 26px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #94a3b8;
}

QLabel#sectionTitle {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
}


/* ============================================================
   DASHBOARD METRIC CARDS
   ============================================================ */

QFrame#metricCard {
    background-color: #1e293b;

    border: 1px solid #334155;
    border-radius: 10px;
}

QFrame#metricCard:hover {
    border: 1px solid #64748b;
}

QLabel#metricTitle {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
}

QLabel#metricValue {
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
}


/* ============================================================
   INPUT FIELDS
   ============================================================ */

QLineEdit,
QComboBox,
QSpinBox,
QTextEdit {
    background-color: #1e293b;
    color: #f8fafc;

    border: 1px solid #334155;
    border-radius: 6px;

    padding: 8px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QTextEdit:focus {
    border: 1px solid #3b82f6;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    color: #f8fafc;

    selection-background-color: #2563eb;
}


/* ============================================================
   COMPONENTS TABLE
   ============================================================ */

QTableWidget {
    background-color: #1e293b;
    alternate-background-color: #253449;

    color: #f8fafc;

    border: 1px solid #334155;
    border-radius: 8px;

    gridline-color: #334155;

    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #0f172a;
    color: #e2e8f0;

    padding: 10px;

    border: none;
    border-bottom: 1px solid #334155;

    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}


/* ============================================================
   ACTION BUTTONS
   ============================================================ */

QPushButton#primaryButton {
    background-color: #2563eb;
    color: #ffffff;

    border-radius: 6px;
    padding: 10px 16px;

    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#secondaryButton {
    background-color: #334155;
    color: #ffffff;
}

QPushButton#secondaryButton:hover {
    background-color: #475569;
}

QPushButton#dangerButton {
    background-color: #b91c1c;
    color: #ffffff;
}

QPushButton#dangerButton:hover {
    background-color: #991b1b;
}

QPushButton#refreshButton {
    background-color: #334155;
    color: #ffffff;
}

QPushButton#refreshButton:hover {
    background-color: #475569;
}

QPushButton:disabled {
    background-color: #1e293b;
    color: #64748b;
}


/* ============================================================
   DIALOGS
   ============================================================ */

QDialog {
    background-color: #111827;
}

QDialog QLabel {
    color: #e5e7eb;
}

QDialogButtonBox QPushButton {
    background-color: #334155;
    color: #ffffff;

    border-radius: 6px;
    padding: 8px 16px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #475569;
}


/* ============================================================
   SCROLLBARS
   ============================================================ */

QScrollBar:vertical {
    background-color: #0f172a;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #475569;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0f172a;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #475569;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}