# ========================================
# CircuitVault .gitignore
# ========================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE / Editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Python build files
build/
dist/
*.egg-info/

# Test / coverage files
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*